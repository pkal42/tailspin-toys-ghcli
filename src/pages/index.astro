---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GamesGrid from '../components/GamesGrid.astro';
import Pagination from '../components/Pagination.astro';
import { getDatabase } from '../lib/db';
import { getGamesPage, getGamesPageCount } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getGamesPage(db, 1);
const totalPages = await getGamesPageCount(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <GamesGrid games={games} />
      <Pagination basePath="/" currentPage={1} totalPages={totalPages} />
    </div>
  </div>
</Layout>
